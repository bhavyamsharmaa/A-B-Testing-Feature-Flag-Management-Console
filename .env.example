# Helios backend configuration.
#
# The backend reads these from the process environment (it does not auto-load
# this file). Load them however you prefer, e.g. `set -a; . ./.env; set +a`,
# direnv, or your IDE run config. Defaults below match the docker-compose services.

PORT=8080
DATABASE_URL=postgres://helios:helios@localhost:5432/helios?sslmode=disable

# Optional. redis:// or rediss:// connection string (rediss:// turns on TLS,
# which managed providers like Upstash require). Leave unset to run without
# propagation — flag-change push over /sdk/stream is disabled, but /evaluate
# is entirely unaffected: it reads Postgres directly either way. Startup
# never fails because of this var, set or not, reachable or not.
REDIS_URL=

# Required. Your Supabase project URL (Project Settings -> API -> Project URL).
# Access tokens are verified against its public signing keys at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json; no secret is needed.
SUPABASE_URL=https://vsbjakrmckmzqbomqnhi.supabase.co

# Comma-separated browser origins allowed to call the API (e.g. your Vercel
# URL, no trailing slash). Empty means cross-origin browser calls are refused.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Multi-tenancy hardening (all optional; see docs/LOCAL_MULTITENANCY.md) -----
# The project's PUBLIC anon/publishable key (not a secret). With it the backend
# asks Supabase whether a user's email is confirmed and defaults to strict mode.
SUPABASE_ANON_KEY=
# off | enforce | strict. Empty = enforce (strict when SUPABASE_ANON_KEY is set).
EMAIL_CONFIRMATION=
# false: invites can only be accepted with their one-time link.
INVITES_BY_ID=
# Rate limits: overrides like "me=5/60,accept=2/50"; TRUSTED_PROXY_HOPS=1 behind
# one reverse proxy (defaults to 1 when RENDER=true); STREAMS_PER_KEY caps streams.
RATE_LIMITS=
RATE_LIMIT_DISABLED=
TRUSTED_PROXY_HOPS=
STREAMS_PER_KEY=
