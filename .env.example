# Helios backend configuration.
#
# The backend reads these from the process environment (it does not auto-load
# this file). Load them however you prefer, e.g. `set -a; . ./.env; set +a`,
# direnv, or your IDE run config. Defaults below match the docker-compose services.

PORT=8080
DATABASE_URL=postgres://helios:helios@localhost:5432/helios?sslmode=disable
REDIS_ADDR=localhost:6379
